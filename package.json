{
  "name": "@local/dsh-data-analysis",
  "version": "0.3.0",
  "private": true,
  "description": "实证研究查看器：把 skill 产物目录只读展示成通用文件查看器（图/表/文档/代码 + 目录进度）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "*"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "src",
    "locale",
    "tests",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/artifacts.test.mjs && node tests/artifact-paths.test.mjs && node tests/readcache.test.mjs && node tests/binding.test.mjs && node tests/tool-output.test.mjs && node tests/client-smoke.test.mjs && node tests/visual.mjs",
    "test:artifacts": "node tests/artifacts.test.mjs",
    "test:paths": "node tests/artifact-paths.test.mjs",
    "test:readcache": "node tests/readcache.test.mjs",
    "test:binding": "node tests/binding.test.mjs",
    "test:tool-output": "node tests/tool-output.test.mjs",
    "test:client": "node tests/client-smoke.test.mjs",
    "test:visual": "node tests/visual.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "data-analysis",
    "research-viewer"
  ],
  "license": "MIT"
}